# Dependencies (Vercel installs these itself from package-lock.json)
node_modules/

# Environment variables: secrets go in Vercel → Project Settings → Environment Variables
.env
.env.*
!.env.example

# Vercel CLI output and local project link
.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime and test output
coverage/
.nyc_output/
*.pid
*.seed
*.pid.lock

# Caches
.cache/
.npm/
.eslintcache

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
